<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same as values/themes.xml on purpose: this file replaces the old dark-mode theme
         (which had an action bar), so dark mode looks the same as light mode. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorAccent">#FFFFB000</item>
        <item name="android:colorPrimary">#FF000000</item>
        <item name="android:colorControlActivated">#FFFFB000</item>
        <item name="android:textColorPrimary">#FFEDEDED</item>
        <item name="android:textColorSecondary">#FF9A9A9A</item>
        <item name="android:textColorHint">#FF7A7A7A</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
    </style>

    <!-- Night red: keeps night vision. Chosen in Settings. -->
    <style name="AppTheme.Red">
        <item name="android:colorAccent">#FFFF453A</item>
        <item name="android:colorControlActivated">#FFFF453A</item>
        <item name="android:textColorPrimary">#FFFF6B61</item>
        <item name="android:textColorSecondary">#FFB8443D</item>
        <item name="android:textColorHint">#FF8A3A35</item>
        <item name="android:alertDialogTheme">@style/Dialog.Red</item>
    </style>

    <style name="Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">#FFFFB000</item>
        <item name="android:colorControlActivated">#FFFFB000</item>
        <item name="android:textColorPrimary">#FFEDEDED</item>
        <item name="android:textColorSecondary">#FF9A9A9A</item>
        <item name="android:textColorHint">#FF7A7A7A</item>
    </style>

    <style name="Dialog.Red">
        <item name="android:colorAccent">#FFFF453A</item>
        <item name="android:colorControlActivated">#FFFF453A</item>
        <item name="android:textColorPrimary">#FFFF6B61</item>
        <item name="android:textColorSecondary">#FFB8443D</item>
    </style>
</resources>
